# Chave da API Google Gemini (https://aistudio.google.com/apikey)
# Sem a chave, o site usa o motor local de conhecimento zoológico.
GEMINI_API_KEY=

# Modelo Gemini utilizado pelo servidor (opcional).
# Padrão: gemini-flash-latest (alias para o modelo Flash mais recente)
GEMINI_MODEL=gemini-flash-latest
